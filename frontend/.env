# Environment variables for the frontend application

# API Configuration
VITE_API_URL=http://localhost:5021/api
VITE_SIGNALR_URL=http://localhost:5021/hubs/auction

# Application Configuration
VITE_APP_NAME=AuctionHouse
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info

# Image Upload Configuration
VITE_MAX_IMAGE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Pagination Configuration
VITE_DEFAULT_PAGE_SIZE=12
VITE_MAX_PAGE_SIZE=50

# Auction Configuration
VITE_MIN_BID_INCREMENT=1.00
VITE_MAX_AUCTION_DURATION_DAYS=30